<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Clips Shatta récents</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #111;
      color: white;
      margin: 0;
      padding: 20px;
    }

    h1 {
      text-align: center;
    }

    #videos {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .video {
      background: #1e1e1e;
      border-radius: 10px;
      margin: 10px;
      padding: 15px;
      width: 300px;
      box-shadow: 0 0 10px rgba(0,0,0,0.5);
    }

    .video img {
      width: 100%;
      border-radius: 8px;
    }

    .video h3 {
      font-size: 16px;
      margin: 10px 0;
    }

    .video p {
      margin: 5px 0;
      font-size: 13px;
      color: #ccc;
    }

    a {
      color: #00d4ff;
      text-decoration: none;
    }

    button {
      margin-top: 8px;
      padding: 8px;
      width: 100%;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      background: #00d4ff;
      color: black;
      font-weight: bold;
    }

    button:hover {
      background: #00aacc;
    }

    .error {
      text-align: center;
      color: red;
      margin-top: 20px;
    }
  </style>
</head>

<body>

<h1>🔥 Nouveaux clips Shatta (30 jours)</h1>

<div id="videos"></div>
<div id="error" class="error"></div>

<script>
async function loadVideos() {
  try {
    const res = await fetch("/api/videos");
    const data = await res.json();

    console.log("Réponse API:", data);

    // ✅ gestion robuste du format
    let videos = [];

    if (Array.isArray(data)) {
      videos = data;
    } else if (Array.isArray(data.items)) {
      videos = data.items;
    } else {
      throw new Error("Format inattendu reçu du serveur");
    }

    const container = document.getElementById("videos");
    container.innerHTML = "";

    videos.forEach(video => {
      if (!video.id?.videoId) return;

      const title = video.snippet.title;
      const channel = video.snippet.channelTitle;
      const date = new Date(video.snippet.publishedAt).toLocaleDateString();
      const videoId = video.id.videoId;
      const thumbnail = video.snippet.thumbnails.medium.url;

      const div = document.createElement("div");
      div.className = "video";

      div.innerHTML = `
        <img srcail}

        <h3>${title}</h3>
        <p>Chaîne: ${channel}</p>
        <p>Date: ${date}</p>

        https://www.youtube.com/watch?v=${videoId}
          ▶ Regarder
        </a>

        <button onclick="downloadVideo('${videoId}', this)">
          📥 Télécharger
        </button>
      `;

      container.appendChild(div);
    });

  } catch (error) {
    console.error(error);
    document.getElementById("error").innerText =
      "❌ " + error.message;
  }
}

// ✅ téléchargement sans redirection
async function downloadVideo(videoId, button) {
  try {
    button.innerText = "⏳ Téléchargement...";

    const response = await fetch("/download/" + videoId);

    if (!response.ok) {
      throw new Error("Erreur téléchargement");
    }

    const blob = await response.blob();

    const url = window.URL.createObjectURL(blob);
    const a = document.createElement("a");

    a.href = url;
    a.download = videoId + ".mp3";

    document.body.appendChild(a);
    a.click();

    a.remove();
    window.URL.revokeObjectURL(url);

    button.innerText = "✅ Terminé";

  } catch (error) {
    console.error(error);
    button.innerText = "❌ Erreur";
  }
}

// 🚀 lancement
loadVideos();
</script>

</body>
</html>
