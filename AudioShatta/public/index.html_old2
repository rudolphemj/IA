<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Clips Shatta récents</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #111;
      color: white;
      margin: 0;
      padding: 20px;
    }

    h1 {
      text-align: center;
    }

    #videos {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .video {
      background: #1e1e1e;
      border-radius: 10px;
      margin: 10px;
      padding: 15px;
      width: 300px;
      box-shadow: 0 0 10px rgba(0,0,0,0.5);
    }

    .video img {
      width: 100%;
      border-radius: 8px;
    }

    .video h3 {
      font-size: 16px;
      margin: 10px 0;
    }

    .video p {
      margin: 5px 0;
      font-size: 13px;
      color: #ccc;
    }

    .buttons {
      display: flex;
      gap: 10px;
      margin-top: 10px;
    }

    button {
      flex: 1;
      padding: 8px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
    }

    .watch {
      background: #ff0000;
      color: white;
    }

    .download {
      background: #00d4ff;
      color: black;
    }

    .error {
      text-align: center;
      color: red;
      margin-top: 20px;
    }
  </style>
</head>

<body>

<h1>🔥 Nouveaux clips Shatta (30 jours)</h1>

<div id="videos"></div>
<div id="error" class="error"></div>

<script>
async function loadVideos() {
  try {
    const res = await fetch("/api/videos");
    const data = await res.json();

    console.log("Réponse API:", data);

    let videos = [];

    if (Array.isArray(data)) {
      videos = data;
    } else if (Array.isArray(data.items)) {
      videos = data.items;
    } else {
      throw new Error("Format inattendu reçu du serveur");
    }

    const container = document.getElementById("videos");
    container.innerHTML = "";

    videos.forEach(video => {
      if (!video.id?.videoId) return;

      const title = video.snippet.title;
      const channel = video.snippet.channelTitle;
      const date = new Date(video.snippet.publishedAt).toLocaleDateString();
      const videoId = video.id.videoId;
      const thumbnail = video.snippet.thumbnails.medium.url;

      const div = document.createElement("div");
      div.className = "video";

      div.innerHTML = `
        ${thumbnail}

        <h3>${title}</h3>
        <p>Chaîne: ${channel}</p>
        <p>Date: ${date}</p>

        <div class="buttons">
          <button class="watch" onclick="openVideo('${videoId}')">
            ▶️ Regarder
          </button>

          <button class="download" onclick="downloadVideo('${videoId}', this)">
            📥 Télécharger
          </button>
        </div>
      `;

      container.appendChild(div);
    });

  } catch (error) {
    console.error(error);
    document.getElementById("error").innerText = "❌ " + error.message;
  }
}

// ✅ Ouvre YouTube dans un nouvel onglet
function openVideo(videoId) {
  const url = `https://www.youtube.com/watch?v=${videoId}`;
  window.open(url, "_blank");
}

// ✅ Téléchargement sans quitter la page
async function downloadVideo(videoId, button) {
  try {
    button.innerText = "⏳...";

    const response = await fetch("/download/" + videoId);

    const contentType = response.headers.get("content-type");

    if (!response.ok) {
      const err = await response.json().catch(() => null);
      throw new Error(err?.error || "Erreur téléchargement");
    }

    const blob = await response.blob();

    const url = window.URL.createObjectURL(blob);
    const a = document.createElement("a");

    a.href = url;
    a.download = videoId + ".mp3";

    document.body.appendChild(a);
    a.click();

    a.remove();
    window.URL.revokeObjectURL(url);

    button.innerText = "✅";

  } catch (error) {
    console.error(error);
    button.innerText = "❌";
    alert(error.message);
  }
}

// 🚀 lancement
loadVideos();
</script>

</body>
</html>
